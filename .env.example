# Resend API Configuration
RESEND_API_KEY=your_resend_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Backend (debug builds only — release always hits qent-backend.onrender.com)
# Example for Android emulator hitting host machine: http://10.0.2.2:8090/api
# Example for physical device on same LAN: http://192.168.x.x:8090/api
API_BASE_URL=http://10.0.2.2:8090/api

# V2 §6.4 — Privy embedded wallet auth.
# Get these at https://console.privy.io. The OAuth scheme must match
# the CFBundleURLSchemes entry in ios/Runner/Info.plist and the
# <data android:scheme="..."> in AndroidManifest.xml (both default
# to `qentauth`).
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_CLIENT_ID=your_privy_app_client_id
PRIVY_OAUTH_SCHEME=qentauth
